//@ mode: co2
//@ run-status: 0

use std::vec::Vec;
use std::mem::drop;

#include <assert.h>

int foo() {
    Vec::<i32> v = Vec::<i32>::new();
    v.push(1);
    v.push(2);
    v.extend::<Vec<i32>>(v.clone());
    int r = v.len();
    drop(v);
    return r;
}

fn main() {
    Vec::<i32> v = Vec::<i32>::new();
    v.push(1);
    v.push(2);
    v.push(3);
    v.extend(v.clone());
    v.extend(v.clone());
    v.extend::<Vec<i32>>(v.clone());
    assert(v.len() == 24);

    assert(foo() == 4);
    drop(v);
}
