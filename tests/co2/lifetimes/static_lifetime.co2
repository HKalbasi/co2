//@ mode: co2

use std::borrow::Cow;
use std::string::String;
use std::mem::drop;

fn p1(x: Cow<'static, str>) {
    Cow::<'static, str> y = x;
    String z = y.into_owned();
    drop(z);
}

fn p2(x: &'static str) {
    ::<&'static str> y = x;
    String z = y.to_owned();
    drop(z);
}

fn main() {
}
