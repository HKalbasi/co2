//@ mode: co2
//@ miri-error

fn conditional_init_indirect(init: i32) -> i32 {
    i32 x;
    i32 *y = &x;
    if (init) {
        *y = 5;
    }
    return x * 3;
}

typedef struct { int x; int y; } St;

fn init_struct(st: *mut St) {
    st->x = 1;
    st->y = 2;
}

fn init_array() -> i32 {
    i32 ar[5];
    ar[0] = 1;
    ar[1] = 2;
    for (usize i = 2; i < 5; i += 1) {
        ar[i] = ar[i - 1] + ar[i - 2];
    }
    return ar[4];
}

fn init_array2() -> i32 {
    St ar[5];
    auto ptr = ar;
    St **ptr2 = &ptr;
    ptr2[0][0].x = 1;
    ptr2[0][2].y = 5;
    return ar[0].x + ar[2].y;
}

fn conditional_init(init: i32) -> i32 {
    i32 x;
    if (init) {
        x = 5;
    }
    return x * 3;
         //^^^^^ error: Undefined Behavior: using uninitialized data, but this operation requires initialized memory
}

fn main() {
    conditional_init_indirect(1);

    St st;
    init_struct(&st);
    if (st.x + st.y != 3) {
        std::process::abort();
    }

    init_array();
    init_array2();

    conditional_init(1);
    conditional_init(0);
}
